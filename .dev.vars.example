# =====================================================================
# .dev.vars.example — list of every secret / environment variable
# ---------------------------------------------------------------------
# HOW TO USE (local testing):
#   1. Copy this file and name the copy ".dev.vars"   (cp .dev.vars.example .dev.vars)
#   2. Fill in the values in .dev.vars
#   .dev.vars is git-ignored, so it never goes to GitHub.
#
# FOR THE LIVE SITE: set each one with
#   npx wrangler pages secret put NAME
# (it asks you to paste the value — it is never shown or saved in files)
#
# NEVER paste these values into chat, emails, or the code.
# Empty values are OK while a feature isn't set up yet.
# =====================================================================

# ---------- Admin login (Phase 4) ----------
# Username for the owner's first admin login, e.g. "owner"
ADMIN_USERNAME=
# PBKDF2 hash of the owner's password. Create it with:
#   node scripts/hash-password.js
# (paste the hash, NOT the password)
ADMIN_PASSWORD_HASH=
# Long random text used to sign login cookies. Create one with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# ---------- Telegram order alerts (Phase 3) ----------
# From @BotFather in Telegram, looks like 123456789:ABCdef...
TELEGRAM_BOT_TOKEN=
# The owner's chat id (a number). README explains how to find it.
# Several people? Separate with commas: 11111111,22222222
TELEGRAM_CHAT_ID=

# ---------- Optional email alerts via Resend.com (Phase 3) ----------
RESEND_API_KEY=
# Where alerts go, e.g. owner@gmail.com
ALERT_EMAIL_TO=
# Sender address on a domain verified in Resend, e.g. orders@yourdomain.in
ALERT_EMAIL_FROM=

# ---------- Website address ----------
# Full address of the live site (used in Telegram links), no trailing slash
# Local: http://localhost:8788   Live: https://yourdomain.in
SITE_URL=http://localhost:8788

# ---------- Razorpay (OPTIONAL, off by default — Phase 5) ----------
# From Razorpay Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Text you choose when creating the webhook in Razorpay
RAZORPAY_WEBHOOK_SECRET=

# ---------- Google Analytics 4 (Phase 5) ----------
# Measurement ID like G-XXXXXXXXXX (not secret, but kept here with the rest)
GA4_ID=
