# =====================================================================
# .env.example — list of every secret / environment variable
# ---------------------------------------------------------------------
# LOCAL TESTING:
#   Copy this file to ".env.local" and fill in what you need.
#   .env.local is git-ignored, so it never goes to GitHub.
#   Everything can stay empty for local testing — the site then uses a
#   local database file (local.db) and simply skips alerts.
#
# LIVE SITE (Vercel):
#   Vercel dashboard > your project > Settings > Environment Variables
#   Add each NAME + value there, then Redeploy.
#
# NEVER paste these values into chat, emails, or the code.
# =====================================================================

# ---------- Database (Turso) ----------
# Added AUTOMATICALLY when you connect Turso from Vercel > Storage.
# Leave empty locally to use the local.db file instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------- Website address ----------
# Full address of the live site (used in Telegram links), no trailing slash
SITE_URL=http://localhost:3000

# ---------- Admin login (Phase 4) ----------
# Username for the owner's first admin login, e.g. "owner"
ADMIN_USERNAME=
# Hash of the owner's password, made with:  node scripts/hash-password.js
# (paste the hash, NOT the password)
ADMIN_PASSWORD_HASH=
# Long random text used to sign login cookies. Make one with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# ---------- Telegram order alerts (Phase 3) ----------
# From @BotFather in Telegram, looks like 123456789:ABCdef...
TELEGRAM_BOT_TOKEN=
# The owner's chat id (a number). Several people? Separate with commas.
TELEGRAM_CHAT_ID=

# ---------- Optional email alerts via Resend.com (Phase 3) ----------
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# ---------- Product photo uploads: Vercel Blob (Phase 4) ----------
# Added AUTOMATICALLY when you create a Blob store in Vercel > Storage.
BLOB_READ_WRITE_TOKEN=

# ---------- Razorpay (OPTIONAL, off by default — Phase 5) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Google Analytics 4 (Phase 5) ----------
GA4_ID=
